<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <form action="/signup" method="post">
        <div>
            <label for="username">Enter your username</label>
            <input required value="<%= locals.prevData?.username || '' %>" type="text" name="username" id="username">
        </div>
        <% if (locals.err?.username) { %>
            <div>
                <p>
                    <%= locals.err.username.msg %>
                </p>
            </div>
            <% } %>
                <% if (locals.uniqueNameError) { %>
                    <div>
                        <p>
                            <%= locals.uniqueNameError %>
                        </p>
                    </div>
                    <% } %>

                        <div>
                            <label for="password">Enter your password</label>
                            <input required type="password" name="password" id="password">
                        </div>
                        <% if (locals.err?.password) { %>
                            <div>
                                <p>
                                    <%= locals.err.password.msg %>
                                </p>
                            </div>
                            <% } %>
                                <button type="submit">sign up</button>
    </form>
</body>

</html>