<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <p>Here you will see the files:</p>
    <%- include('addfile') %>
        <% if (locals.files && locals.files.length> 0) { %>
            <% locals.files.forEach(function(file) { %>
                <img src="<%= file.link %>" alt="Uploaded image">
                <% }); %>
                    <% } else { %>
                        <p>No files available.</p>
                        <% } %>
</body>

</html>