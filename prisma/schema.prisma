generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime

  @@map("session")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  registerAt DateTime @default(now())
  folders    Folder[]

  @@map("user")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  files     File[]

  @@map("folder")
}

model File {
  id       Int      @id @default(autoincrement())
  type     FileType
  link     String
  origin   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId Int
  addedAt  DateTime @default(now())

  @@map("file")
}

enum FileType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  OTHERS
}
